{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3211/fa",
        "http://127.0.0.1:3211/en",
        "http://127.0.0.1:3211/fa/printing",
        "http://127.0.0.1:3211/fa/products/effervescent-tube",
        "http://127.0.0.1:3211/fa/products/multi-layer-tube"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:performance": ["warn", { "minScore": 0.6, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
