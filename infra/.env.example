# Production settings for infra/docker-compose.prod.yml. Copy to infra/.env (never commit it).
# Secrets: `docker compose run --rm opex-api node --no-warnings src/cli.ts keys:generate` prints a full set.

SITE_DOMAIN=arapoush.com
OPEX_DOMAIN=opex.arapoush.com
CONSOLE_DOMAIN=console.opex.arapoush.com
ACME_EMAIL=
# Office / VPN ranges allowed to open the console (space separated); also checked by the API.
# Required: compose refuses to start without it. "0.0.0.0/0 ::/0" opens the console to the internet.
CONSOLE_ALLOW=
CONSOLE_ALLOWED_CIDRS=

POSTGRES_PASSWORD=
SESSION_SECRET=
DELIVERY_TOKEN=
SITE_WEBHOOK_SECRET=
OPEX_JWT_PRIVATE_JWK=
OPEX_JWT_PREVIOUS_JWKS=
INQUIRY_KEY=
INQUIRY_KEYS_OLD=
METRICS_TOKEN=
RENDER_TOKEN=

INQUIRY_TO=sales@arapoush.com
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=OPEX <no-reply@arapoush.com>
TURNSTILE_SECRET=
# Blog: AI translation drafts in the post editor (Claude). Empty = off.
ANTHROPIC_API_KEY=

# Helpdesk (P11): replies to customers come from this address; their answers are read from its mailbox.
SUPPORT_ADDRESS=support@arapoush.com
SUPPORT_NAME=Arapoush
# imaps://user:password@mail.example.com:993/INBOX (unset: inbound email off)
IMAP_URL=

# Host path of the write-once audit archive (mount WORM storage or sync it to S3 Object Lock).
AUDIT_ARCHIVE_PATH=/srv/opex/audit-archive

# Console backups (Settings → Backups). Host folder for the archives, and the encryption secret
# (32+ characters). Without BACKUP_KEY the key is derived from INQUIRY_KEY. Store a copy of the key
# away from this server: an archive cannot be restored without it.
BACKUP_PATH=./opex-backups
BACKUP_KEY=
