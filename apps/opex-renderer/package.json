    "once": "node --no-warnings src/main.ts --once",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "puppeteer-core": "25.14.0"
  },
  "devDependencies": {
    "@arapoush/config": "workspace:*",
    "@types/node": "22.15.29",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
