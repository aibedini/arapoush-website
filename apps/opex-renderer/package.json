{
  "name": "@arapoush/opex-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "OPEX 3D renderer (P10): claims render jobs, drives the website's effervescent 3D scene in headless Chromium, uploads the images.",
  "type": "module",
  "scripts": {
