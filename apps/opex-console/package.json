{
  "name": "@arapoush/opex-console",
  "version": "0.1.0",
  "private": true,
  "description": "OPEX operator console: content editing, publishing, media, audit log, operators and partners.",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "test:stories": "vitest run --config vitest.storybook.config.mts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@arapoush/config": "workspace:*",
    "@arapoush/schema": "workspace:*",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/nextjs-vite": "10.6.5",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "9.39.5",
    "playwright": "1.64.1",
    "storybook": "10.6.5",
    "typescript": "5.8.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
