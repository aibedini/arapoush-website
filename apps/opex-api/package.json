{
  "name": "@arapoush/opex-api",
  "version": "0.1.0",
  "private": true,
  "description": "OPEX core: content, identity, permissions, change requests, audit and publishing (docs/opex/OPEX-PLAN.md).",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --no-warnings src/server.ts",
    "start": "node --no-warnings src/server.ts",
    "migrate": "node --no-warnings src/cli.ts migrate",
    "seed": "node --no-warnings src/cli.ts seed",
    "cli": "node --no-warnings src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "dev:watch": "node --env-file-if-exists=.env.local --watch-path=src --watch-path=../../packages/schema/src --no-warnings src/server.ts",
    "docs:api": "node --no-warnings src/openapi/cli.ts",
    "docs:api:check": "node --no-warnings src/openapi/cli.ts --check",
    "docs:coverage": "node --no-warnings src/openapi/coverage.ts",
    "docs:lint": "npx -y @redocly/cli@2.72.0 lint --config ../../redocly.yaml",
    "docs:breaking": "node --no-warnings src/openapi/breaking.ts"
  },
  "dependencies": {
    "@arapoush/schema": "workspace:*",
    "@electric-sql/pglite": "0.5.12",
    "@fastify/cookie": "11.1.5",
    "@fastify/formbody": "9.0.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@node-rs/argon2": "2.2.2",
    "@scalar/api-reference": "1.76.2",
    "fastify": "5.12.7",
    "imapflow": "2.9.1",
    "jose": "6.2.13",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@arapoush/config": "workspace:*",
    "@types/mailparser": "3.9.0",
    "@types/node": "22.15.29",
    "@types/pg": "8.23.1",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
