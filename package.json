{
  "name": "arapoush-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Arapoush website and the OPEX content platform (see docs/opex/OPEX-PLAN.md).",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "turbo run dev --filter=@arapoush/web",
    "build": "turbo run build",
    "start": "pnpm --filter @arapoush/web start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test build",
    "audit:lighthouse": "bash .lighthouse/run.sh /fa audit-mobile && bash .lighthouse/run.sh /fa audit-desktop desktop",
    "docs:api": "pnpm --filter @arapoush/opex-api docs:api",
    "docs:api:check": "pnpm --filter @arapoush/opex-api docs:api:check"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  },
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.31",
      "sharp": "0.35.5"
    }
  }
}
